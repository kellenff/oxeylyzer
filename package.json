{
  "description": "Script aliasing to be able to run things from the project root",
  "scripts": {
    "dev": "cd oxeylyzer-tauri && bun tauri dev",
    "build-tauri": "cd oxeylyzer-tauri && bun tauri build",
    "install": "cd oxeylyzer-tauri && bun install",
    "fmt": "cd oxeylyzer-tauri && bun prettier ./src -w",
    "check": "cd oxeylyzer-tauri && bun run check"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
